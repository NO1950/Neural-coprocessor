+// ---- R320 (B3): A VELOCITY SOURCE NAMED BY ITS TEXTURE VARIABLE ----
+//
+// WHAT THE CENSUS CANNOT SEE. Everything above acquires by watching the GAME:
+// init_resource gives a handle, the bind events give a size and a format, the
+// ranking picks one, and the transport copies it. A resource the game never
+// created is invisible to all of it - and on 2026-10-18 three routes that tried
+// to supply a field from outside were measured dead: B1 (a .fx writer), B4 (an
+// add-on creating the texture itself, by two different creation paths), B5 (a
+// shared texture handed to the feeder). The census holds what the game creates
+// and nothing else.
+//
+// THE OTHER QUESTION. This file already asks the ReShade API a different one,
+// for DEPTH: not "what does the game render into" but "what is bound to THIS
+// TEXTURE VARIABLE right now". The pinned header answers it in four calls:
+//
+//   find_texture_variable(effect_name, variable_name)   -> handle, or 0
+//   get_texture_binding(variable, &srv, &srv_srgb)      -> the view bound this frame
+//   device::get_resource_from_view(srv)                 -> the resource behind it
+//   device::get_resource_desc(resource)                 -> size and format
+//
+// So a texture the add-on can NAME is a texture the transport can copy, whoever
+// created it. That is the whole of B3: no census membership, no ranking, no bind
+// counting - one name, read from mgpu.ini, and the two tests the census applies
+// (motion-vector format, scene size band) so a wrong name cannot smuggle a wrong
+// texture into the model.
+//
+// MVecTexName=<variable name> in mgpu.ini. ABSENT = OFF: no lookup, no binding
+// read, no barrier, no log line, nothing. Set, it wins over every other source
+// rule - the ranking, MVecCandidate, the defer, the pick lock - because it is the
+// only one that was asked for by name.
+//
+// THE STATE ASSUMPTION IS shader_resource, AND IT IS AN ASSUMPTION. The binding
+// handed over is an SRV, and by finish_effects the pass that wrote the texture has
+// transitioned it for the next reader. That is the same assumption MVecTap=1 makes
+// (R277) and the same transition arm C already issues on ReShade's own depth
+// (R55). A wrong assumption is undefined behaviour, not an error that can be
+// caught - so the copy count in [R78] and the content probe in [R257] are the
+// judges of this lane, not this comment.
+//
+// SELF-HEALING (the R63 pattern): an unbound frame clears the variable handle and
+// the next frame re-resolves it, and the handle is re-resolved every
+// R320_RESOLVE_FRAMES anyway so an effect reload cannot leave a stale one behind.
+const unsigned R320_RESOLVE_FRAMES = 240;
+
+reshade::api::effect_texture_variable g_mvtex_var = {};
+unsigned long long g_mvtex_at = ~0ull;             // frame of the last resolve
+unsigned long long g_mvtex_hits = 0, g_mvtex_miss = 0;
+unsigned long long g_mvtex_said_res = 0;           // last resource published and reported
+
+// One state, so "the same name bound to a different resource" is a log line
+// rather than silence; and one per refusal reason, so a wrong name is reported
+// once instead of every frame.
+int g_mvtex_said_why = 0;
+
+// From mode_from_ini. Empty or absent name turns the lane off completely - the
+// per-frame path below is one compare and a return.
+void mvtex_set_name(const char *name)
+{
+    g_mvtex_name[0] = '\0';
+    if (name != nullptr)
+    {
+        size_t i = 0;
+        for (; i + 1u < sizeof g_mvtex_name && name[i] != '\0' &&
+               name[i] != '\r' && name[i] != '\n' && name[i] != ' ' && name[i] != '\t'; ++i)
+            g_mvtex_name[i] = name[i];
+        g_mvtex_name[i] = '\0';
+    }
+    g_mvtex_var = reshade::api::effect_texture_variable{};
+    g_mvtex_res.store(0ull, std::memory_order_relaxed);
+    g_mvtex_at = ~0ull;
+    g_mvtex_said_res = 0ull;
+    g_mvtex_said_why = 0;
+}
+
+// Once per frame, on the game's render thread, from note_effects - the same place
+// and for the same reason as the R63 depth block: Depth=1 must not require
+// MetaProbe, and neither must MVecTexName.
+void mvtex_tick(reshade::api::effect_runtime *rt, reshade::api::command_list *cl)
+{
+    if (g_mvtex_name[0] == '\0' || rt == nullptr) return;
+
+    const unsigned long long fr = g_frames.load(std::memory_order_relaxed);
+    if (g_mvtex_var.handle == 0 || fr - g_mvtex_at >= R320_RESOLVE_FRAMES)
+    {
+        g_mvtex_at = fr;
+        g_mvtex_var = rt->find_texture_variable(nullptr, g_mvtex_name);
+        if (g_mvtex_var.handle == 0)
+        {
+            if (g_mvtex_said_why != -1)
+            {
+                g_mvtex_said_why = -1;
+                char l[300];
+                snprintf(l, sizeof l,
+                         "[MGPU][R320] MVecTexName=\"%s\": no such texture variable in any loaded effect. "
+                         "Re-resolving every %u frames; nothing is transported from this key until it appears.",
+                         g_mvtex_name, R320_RESOLVE_FRAMES);
+                mgpu::diag::warn(l);
+            }
+            return;
+        }
+    }
+
+    // ---- what is bound to it THIS frame ----
+    unsigned long long h = 0;
+    unsigned w = 0, hh = 0, fmt = 0;
+    {
+        reshade::api::resource_view srv = {}, srgb = {};
+        rt->get_texture_binding(g_mvtex_var, &srv, &srgb);
+        if (srv.handle == 0)
+        {
+            // R63's self-heal: unbound this frame is not a handle to keep.
+            g_mvtex_var = reshade::api::effect_texture_variable{};
+            ++g_mvtex_miss;
+        }
+        else if (reshade::api::device *dv = rt->get_device())
+        {
+            const reshade::api::resource r = dv->get_resource_from_view(srv);
+            if (r.handle != 0)
+            {
+                const reshade::api::resource_desc rd = dv->get_resource_desc(r);
+                h = r.handle;
+                w = rd.texture.width;
+                hh = rd.texture.height;
+                fmt = static_cast<unsigned>(rd.texture.format);
+            }
+        }
+    }
+
+    // The same two tests the census applies. A refusal is reported once per
+    // reason: what is bound here is a name the user typed, and a mistyped name
+    // usually lands on a perfectly valid texture of the wrong kind.
+    int why = 0;
+    if (h == 0) why = 3;                       // nothing bound right now
+    else if (!is_mvec_format(fmt)) why = 1;    // not two-channel motion-vector data
+    else if (!in_scene_band(w, hh)) why = 2;   // not scene-sized
+
+    if (why == 0)
+    {
+        ++g_mvtex_hits;
+        g_mvtex_res.store(h, std::memory_order_relaxed);
+        // R320b: the labels [R75] prints for the resource it read. Stored here
+        // because this lane is the only place that knows them, and a probe line
+        // that labels a 3840x2160 read with another buffer's size is how a
+        // correct measurement gets read as a wrong one.
+        g_mv_w.store(w, std::memory_order_relaxed);
+        g_mv_h.store(hh, std::memory_order_relaxed);
+        g_mv_fmt.store(fmt, std::memory_order_relaxed);
+        // Publish as THE source BEFORE the hook fires: fire_mvec_hook copies only
+        // the resource this file has published, and this is the only publisher
+        // that was asked for by name.
+        g_mvec_src.store(h, std::memory_order_relaxed);
+        if (h != g_mvtex_said_res)
+        {
+            g_mvtex_said_res = h;
+            g_mvtex_said_why = 0;
+            char l[400];
+            snprintf(l, sizeof l,
+                     "[MGPU][R320] TEX SOURCE: variable \"%s\" is bound to 0x%016llX (%ux%u %s) - published as the "
+                     "velocity source, winning over the census. The copy is issued at finish_effects with state ASSUMED "
+                     "shader_resource; [R78]'s copies counter and [R257]'s content probe are what say whether it arrived.",
+                     g_mvtex_name, h, w, hh, fmt_name(fmt));
+            mgpu::diag::info(l);
+        }
+        if (cl != nullptr)
+        {
+            // One copy per frame is fire_mvec_hook's own guarantee (g_mvec_last_frame).
+            fire_mvec_hook(cl, h, reshade::api::resource_usage::shader_resource);
+        }
+    }
+    else
+    {
+        g_mvtex_res.store(0ull, std::memory_order_relaxed);
+        // Give the slot back ONLY if it is still ours: the R101 calibrator may have
+        // published the game's own DLSS vector buffer in the meantime, and that one
+        // is authoritative.
+        const unsigned long long pub = g_mvec_src.load(std::memory_order_relaxed);
+        if (g_mvtex_said_res != 0 && pub == g_mvtex_said_res)
+            g_mvec_src.store(0ull, std::memory_order_relaxed);
+        g_mvtex_said_res = 0ull;
+        if (why != g_mvtex_said_why)
+        {
+            g_mvtex_said_why = why;
+            char l[340];
+            if (why == 3)
+                snprintf(l, sizeof l,
+                         "[MGPU][R320] TEX SOURCE idle: variable \"%s\" exists but nothing is bound to it this frame. "
+                         "Waiting; no other source rule is touched while the key is set.",
+                         g_mvtex_name);
+            else
+                snprintf(l, sizeof l,
+                         "[MGPU][R320] TEX SOURCE refused: variable \"%s\" is bound to 0x%016llX (%ux%u %s) - %s. "
+                         "Nothing is transported from this variable until it satisfies both tests.",
+                         g_mvtex_name, h, w, hh, fmt_name(fmt),
+                         (why == 1) ? "not a two-channel motion-vector format" : "not inside the scene size band");
+            mgpu::diag::warn(l);
+        }
+    }
+}
